APP_NAME="Laravel Skeleton"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_THEME=valorant
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

SERVER_NAME=:8080
CONTAINER_ROLE=app
RUN_MIGRATIONS=true
RUN_SEEDERS=true
DB_WAIT_TIMEOUT=60
SEED_DEFAULT_PASSWORD=Developer123!

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=skeleton
DB_USERNAME=skeleton
DB_PASSWORD=skeleton

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_MEDIA_DISK=content_media
PRIVATE_MEDIA_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_RETRY_AFTER=180
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_REQUEST_SIZE_MB=512
PHP_MEMORY_LIMIT=1024M
PHP_MAX_EXECUTION_TIME=600
PHP_MAX_INPUT_TIME=600
PHP_MAX_INPUT_VARS=100000
PHP_MAX_FILE_UPLOADS=100
PHP_POST_MAX_SIZE=512M
PHP_UPLOAD_MAX_FILESIZE=100M

SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_IMAGE_SOURCES="https://cdn.flyonui.com"
SECURITY_CSP_VITE_HTTP_SOURCES="http://localhost:5173 http://127.0.0.1:5173 http://*:5173"
SECURITY_CSP_VITE_WEBSOCKET_SOURCES="ws://localhost:5173 ws://127.0.0.1:5173 ws://*:5173"
SECURITY_HSTS_ENABLED=false
TRUSTED_HOSTS="localhost,127.0.0.1"
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
